---
import '../styles/global.css';
import Reader from '../components/Reader.astro';
import { person } from '../data/cv';
interface Props { title?: string; description?: string }
const { title = `${person.name} · Full Stack Engineer & Tech Lead`, description = 'Daniel Mora, senior full stack engineer in Guadalajara. Web, mobile and AI agent platforms. Open to remote roles and relocation.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const schema = { '@context': 'https://schema.org', '@type': 'Person', name: person.name, alternateName: person.fullName, jobTitle: person.role, url: new URL('/', canonical).href, email: person.email, sameAs: Object.values(person.links) };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title><meta name="description" content={description} />
    <link rel="canonical" href={canonical} /><link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/familjen-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ronzino-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="alternate" type="text/markdown" href="/index.md" title="Daniel Mora in Markdown" />
    <meta name="theme-color" content="#2345bc" />
    <meta property="og:type" content="website" /><meta property="og:site_name" content="Daniel Mora" />
    <meta property="og:title" content={title} /><meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} /><meta property="og:image" content={new URL('/og.png', canonical)} />
    <meta property="og:image:alt" content="Daniel Mora. Full stack engineer and tech lead. Web, mobile, agent platforms." />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header wrap">
      <a class="wordmark" href="/" aria-label="Daniel Mora home">dm<span aria-hidden="true">.</span></a>
      <nav aria-label="Sections"><a href="/#work">Work</a><a href="/#experience">Experience</a><a href="/#contact">Let’s talk</a></nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer wrap"><p>© {new Date().getFullYear()} {person.name}</p><p>Built with care. No cookies, no analytics.</p><a href="/index.md">Read as Markdown <span aria-hidden="true">↗</span></a></footer>
    <Reader />
    <script>import '../scripts/motion.js';</script>
  </body>
</html>
