<!-- No JavaScript: native entry links still work and all CV content is readable. -->
<div class="reader-toolbar" data-reader-toolbar hidden role="region" aria-label="CV reading controls">
  <span class="reader-position" data-reader-position></span>
  <div class="reader-actions">
    <button type="button" data-reader-prev aria-label="Previous entry" title="Previous entry (↑)">↑</button>
    <button type="button" data-reader-next aria-label="Next entry" title="Next entry (↓)">↓</button>
    <button type="button" data-reader-copy aria-label="Copy link to selected entry" title="Copy link"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m10 13 4-4M8 16l-1 1a3.5 3.5 0 0 1-5-5l5-5a3.5 3.5 0 0 1 5 0m0 1 1-1a3.5 3.5 0 0 1 5 5l-5 5a3.5 3.5 0 0 1-5 0" transform="translate(2 0)"/></svg></button>
    <button type="button" data-reader-close aria-label="Clear selection" title="Clear selection (Esc)">×</button>
  </div>
</div>
<p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-reader-status></p>
<script>import '../scripts/reader.js';</script>
