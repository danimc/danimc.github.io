---
import { jobs } from '../data/cv';
const ids = ['experience-heydonto-ai', 'experience-algotive', 'experience-jalisco', 'experience-guadalajara'];
---
<section id="experience" class="experience wrap section-space" aria-labelledby="experience-title">
  <div class="section-heading"><h2 id="experience-title">Experience</h2><p>2014 - Present</p></div>
  <ol class="job-list" data-cv-group="Experience">{jobs.map((j, i) => (<>
    <li id={ids[i]} class:list={['job', { 'job-current': i === 0 }]} data-cv-entry>
      <div class="job-date"><p>{j.period ?? `${j.from} - ${j.to}`}</p>{i === 0 && <span class="current-label">Current role</span>}</div>
      <div class="job-content"><p class="job-company">{j.company}</p><h3><a class="entry-trigger" data-entry-select href={`#${ids[i]}`}>{j.title}<span class="entry-permalink" aria-hidden="true"></span></a></h3><p class="job-scope">{j.scope}</p>{j.proof && <p class="job-proof">{j.proof}</p>}{j.stack && <p class="job-stack">{j.stack}</p>}{j.details && <details class="entry-details"><summary>Read role details<span aria-hidden="true">+</span></summary><div class="detail-content">{j.details.map(d => <div><h4>{d.label}</h4><p>{d.text}</p></div>)}</div></details>}</div>
      <span class="job-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
    </li>
    {j.gapAfter && <li class="career-note">{j.gapAfter.from} - {j.gapAfter.to} · {j.gapAfter.what}</li>}
  </>))}</ol>
</section>
