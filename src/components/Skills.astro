---
import { skills, filters } from '../data/cv';
const slug = (name: string) => 'skill-' + name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const filterCss = filters.filter(f => f.id !== 'all').map(f => `.skills:has([value=${f.id}]:checked) li[data-tags]:not([data-tags~=${f.id}]){display:none}`).join('');
---
<section id="skills" class="skills wrap section-space" aria-labelledby="skills-title">
  <div class="section-heading"><h2 id="skills-title">What I build</h2></div>
  <fieldset class="skill-filters"><legend>Explore by focus</legend>{filters.map((f,i) => <label><input type="radio" name="skill-filter" value={f.id} checked={i === 0} /><span>{f.label}</span></label>)}</fieldset>
  <p class="filter-status" role="status" aria-live="polite" data-filter-status>Showing all {skills.length} skills.</p>
  <ul class="skill-list" data-cv-group="Skills">{skills.map(s => <li id={slug(s.name)} data-tags={s.tags} data-cv-entry><h3><a class="entry-trigger" data-entry-select href={`#${slug(s.name)}`}>{s.name}<span class="entry-permalink" aria-hidden="true"></span></a></h3><div><p>{s.what}</p><p class="skill-stack">{s.stack}</p></div></li>)}</ul>
</section>
<Fragment set:html={`<style>${filterCss}</style>`} />
<script>
  const section = document.querySelector('#skills');
  section?.addEventListener('change', () => {
    const selected = section.querySelector<HTMLInputElement>('input:checked');
    const rows = [...section.querySelectorAll<HTMLElement>('[data-tags]')];
    const count = rows.filter(row => selected?.value === 'all' || row.dataset.tags?.split(' ').includes(selected?.value ?? '')).length;
    const status = section.querySelector('[data-filter-status]');
    if (status) status.textContent = `Showing ${count} skills for ${selected?.closest('label')?.textContent?.trim()}.`;
  });
</script>
