---
import { skills, filters } from '../data/cv';
const label = 'flex items-baseline gap-3 border-b border-line pb-3 text-sm font-bold';
// One rule per filter: hide rows without the checked tag. Pure CSS, no JS.
const filterCss = filters.filter((f) => f.id !== 'all')
  .map((f) => `.skills:has([value=${f.id}]:checked) tr[data-tags]:not([data-tags~=${f.id}]){display:none}`).join('');
---
<section id="skills" class="skills scroll-mt-16 pt-16">
  <h2 class={label}>Skills <span class="font-sans font-normal text-muted">filter by the role you are hiring for</span></h2>
  <fieldset class="mt-6 flex min-w-0 flex-wrap gap-2">
    <legend class="sr-only">Filter skills by role</legend>
    {filters.map((f, i) => (
      <label class="cursor-pointer rounded-full bg-panel px-3 py-1 text-sm font-semibold text-muted transition-colors duration-500 ease-fluid hover:text-fg has-checked:bg-fg has-checked:text-bg has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-accent">
        <input type="radio" name="skill-filter" value={f.id} checked={i === 0} class="sr-only" />{f.label}
      </label>
    ))}
  </fieldset>
  <table class="mt-4 w-full text-base">
    <thead>
      <tr class="border-b border-line text-left text-sm text-muted">
        <th class="py-2 pr-4 font-normal">Skill</th>
        <th class="py-2 pr-4 font-normal">What I do with it</th>
        <th class="hidden py-2 font-normal sm:table-cell">Stack</th>
      </tr>
    </thead>
    <tbody>
      {skills.map((s) => (
        <tr data-tags={s.tags} class="border-b border-line align-top">
          <td class="w-1/3 py-4 pr-4 font-display text-lg font-bold tracking-tight">{s.name}</td>
          <td class="py-4 pr-4 text-soft">{s.what}</td>
          <td class="hidden py-4 text-sm text-muted sm:table-cell">{s.stack}</td>
        </tr>
      ))}
    </tbody>
  </table>
</section>

<Fragment set:html={`<style>${filterCss}</style>`} />
