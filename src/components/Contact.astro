---
import { faq, person } from '../data/cv';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const label = 'flex items-baseline gap-3 border-b border-line pb-3 text-sm font-bold';
const field = 'inline-block border-b-2 border-line bg-transparent px-1 text-fg outline-none transition-colors duration-500 ease-fluid placeholder:text-muted focus:border-accent aria-[invalid=true]:border-accent';
---
<section aria-labelledby="faq-title" class="pt-16">
  <h2 id="faq-title" class={label}>Questions recruiters ask</h2>
  <dl>
    {faq.map((f) => (
      <div class="grid gap-x-6 gap-y-1 border-b border-line py-4 sm:grid-cols-[14rem_1fr]">
        <dt class="font-display text-base font-bold">{f.q}</dt>
        <dd class="text-base text-soft">{f.a}</dd>
      </div>
    ))}
  </dl>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>

<section id="contact" class="scroll-mt-16 pt-16 pb-24">
  <h2 class={label}>Contact</h2>
  <p class="mt-8 font-display text-4xl font-bold tracking-tight md:text-5xl">Hiring for a senior or lead role?</p>
  <form data-madlib novalidate action={`mailto:${person.email}`} method="post" enctype="text/plain" class="mt-6 max-w-[40rem] text-2xl text-soft md:text-3xl">
    <p>
      Hi Daniel, I am
      <label class="sr-only" for="m-name">Your name</label>
      <input id="m-name" name="name" required autocomplete="name" placeholder="your name" size="9" class={field} />
      from
      <label class="sr-only" for="m-company">Company</label>
      <input id="m-company" name="company" required autocomplete="organization" placeholder="company" size="8" class={field} />.
      We are hiring a
      <label class="sr-only" for="m-role">Role</label>
      <select id="m-role" name="role" class={`${field} cursor-pointer`}>
        <option class="bg-bg">senior full stack engineer</option>
        <option class="bg-bg">tech lead</option>
        <option class="bg-bg">mobile engineer</option>
        <option class="bg-bg">AI engineer</option>
      </select>
      to work
      <label class="sr-only" for="m-where">Where</label>
      <select id="m-where" name="where" class={`${field} cursor-pointer`}>
        <option class="bg-bg">remotely</option>
        <option class="bg-bg">with relocation</option>
        <option class="bg-bg">hybrid</option>
      </select>
      and I would like to talk.
    </p>
    <p data-error role="alert" class="mt-4 min-h-6 text-base text-accent"></p>
    <div class="mt-4 flex flex-wrap items-center gap-6 text-base">
      <button type="submit" class="rounded-full bg-fg px-3 py-2 font-semibold text-bg transition-transform duration-700 ease-fluid hover:-translate-y-0.5 active:scale-[0.98]">Write the email</button>
      <span class="text-muted">or write to <a class="text-fg underline decoration-line underline-offset-4 hover:decoration-fg" href={`mailto:${person.email}`}>{person.email}</a></span>
      <button type="button" data-copy hidden class="text-muted underline decoration-line underline-offset-4 hover:text-fg">Copy</button>
    </div>
  </form>
</section>

<script>
  import { person } from '../data/cv';
  const email = person.email;
  const form = document.querySelector<HTMLFormElement>('[data-madlib]')!;
  const error = form.querySelector('[data-error]')!;

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const missing = ['name', 'company'].filter((k) => !String(data.get(k) ?? '').trim());
    form.querySelectorAll('input').forEach((i) => i.setAttribute('aria-invalid', String(missing.includes(i.name))));
    if (missing.length) {
      error.textContent = `Add your ${missing.join(' and ')} so I know who is writing.`;
      form.querySelector<HTMLInputElement>(`[name=${missing[0]}]`)?.focus();
      return;
    }
    error.textContent = '';
    const subject = `${data.get('role')} role at ${data.get('company')}`;
    const body = `Hi Daniel,\n\nI am ${data.get('name')} from ${data.get('company')}. We are hiring a ${data.get('role')} to work ${data.get('where')} and I would like to talk.\n\n`;
    location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });

  const copy = form.querySelector<HTMLButtonElement>('[data-copy]')!;
  copy.hidden = false;
  copy.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(email); copy.textContent = 'Copied'; }
    catch { copy.hidden = true; }
  });
</script>
