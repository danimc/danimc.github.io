---
import { work } from '../data/cv';
---
<section id="professional-work" class="work-section section-space" aria-labelledby="professional-work-title">
  <div class="wrap">
    <div class="section-heading"><h2 id="professional-work-title">Professional engineering scope</h2></div>
    <div class="work-layout">
      <article class="work-feature">
        <p class="work-context">{work[0].context}</p>
        <h3>{work[0].title}</h3>
        <p class="work-intro">{work[0].summary}</p>
        <details class="work-details"><summary>Read platform engineering scope<span aria-hidden="true">+</span></summary><div class="detail-content">{work[0].details.map(d => <div><h4>{d.label}</h4><p>{d.text}</p></div>)}</div></details>
      </article>
      <article class="work-secondary">
        <p class="work-context">{work[1].context}</p>
        <h3>{work[1].title}</h3>
        <p class="work-intro">{work[1].summary}</p>
        <details class="work-details"><summary>Read vision engineering scope<span aria-hidden="true">+</span></summary><div class="detail-content">{work[1].details.map(d => <div><h4>{d.label}</h4><p>{d.text}</p></div>)}</div></details>
        <div class="mobile-proof"><p class="work-context">Mobile delivery</p><h4>From a shared codebase<br />to both app stores.</h4><p>React Native and Expo for iOS and Android, including offline behavior and store release.</p><a href="/#skill-mobile-apps">Focus mobile skills</a></div>
      </article>
    </div>
  </div>
</section>
