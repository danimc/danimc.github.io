---
import { practices, education } from '../data/cv';
---
<section id="practices" class="practice-section section-space" aria-labelledby="practices-title"><div class="wrap"><div class="section-heading"><h2 id="practices-title">Engineering habits</h2></div><ol class="practice-list" data-cv-group="Engineering habits">{practices.map((p,i) => <li id={`practice-${i+1}`} data-cv-entry><span class="practice-index" aria-hidden="true">0{i+1} /</span><div><h3><a class="entry-trigger" data-entry-select href={`#practice-${i+1}`}>{p.title}<span class="entry-permalink" aria-hidden="true"></span></a></h3><p>{p.how}</p></div></li>)}</ol></div></section>
<section class="education wrap section-space" aria-labelledby="education-title"><h2 id="education-title" class="section-label">Education</h2><ul data-cv-group="Education">{education.map((e,i) => <li id={`education-${i+1}`} data-cv-entry><span>{e.when}</span><p><a class="entry-trigger" data-entry-select href={`#education-${i+1}`}>{e.what}<span class="entry-permalink" aria-hidden="true"></span></a></p></li>)}</ul></section>
