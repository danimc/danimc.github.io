---
import screen from '../assets/conomi-resumen.webp';
import { portfolioProject as project } from '../data/cv';
---
<section id="conomi" class="product-section wrap section-space" aria-labelledby="work-title">
  <div class="section-heading"><h2 id="work-title">A product you can actually try.</h2><p>Independent work · Released on iOS & Android</p></div>
  <article class="product-feature" aria-labelledby="conomi-title">
    <div class="product-story"><p class="work-context">{project.role} · React Native / Expo</p><h3 id="conomi-title">Conomi<span>.</span></h3><p class="product-lead">Personal finance, built around<br />how credit works in Mexico.</p><p>A mobile app for credit cards, installment purchases and recurring payments. I took it from product design and implementation to release on both app stores.</p><dl class="product-facts"><div><dt>The problem</dt><dd>Several cards, payment dates and installment plans are hard to track together.</dd></div><div><dt>My work</dt><dd>Product UX, TypeScript / React Native implementation, local behavior and store delivery.</dd></div><div><dt>What shipped</dt><dd>Payment schedules, local reminders, exports, backups and import review.</dd></div></dl><div class="product-links"><a class="button" href="/work/conomi/">Read the Conomi case study <span aria-hidden="true">→</span></a><a href={project.links.website}>Visit the live website ↗</a></div><div class="store-evidence"><a href={project.links.apple}>App Store ↗</a><a href={project.links.google}>Google Play ↗</a></div></div>
    <figure class="product-visual"><div class="product-screen"><img src={screen.src} width={screen.width} height={screen.height} alt="Conomi's debt summary screen showing credit utilization and a monthly payment projection." loading="lazy" /></div><figcaption>Actual app screen · sample data</figcaption></figure>
  </article>
</section>
