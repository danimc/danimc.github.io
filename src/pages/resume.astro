---
import Base from '../layouts/Base.astro';
import { person, jobs, education, portfolioProject } from '../data/cv';
---
<Base title="Résumé · Daniel Mora" description="Daniel Mora's résumé. Senior full stack engineering, AI platforms, technical leadership and mobile delivery.">
  <article class="resume-page wrap" aria-labelledby="resume-title">
    <div class="resume-actions"><a href="/">← Back to portfolio</a><button type="button" class="button" data-print-resume hidden>Print / Save PDF</button></div>
    <header class="resume-header"><h1 id="resume-title">{person.fullName}</h1><p class="resume-role">Senior Full Stack Engineer · AI Platforms, TypeScript & Python</p><p>Guadalajara, Mexico · UTC−6 · Open to remote and relocation</p><p><a href={`mailto:${person.email}`}>{person.email}</a> · <a href={person.links.github}>github.com/danimc</a> · <a href={person.links.linkedin}>linkedin.com/in/dany-mc</a></p></header>
    <section aria-labelledby="resume-summary"><h2 id="resume-summary">Summary</h2><p>Full stack engineer building production software since 2014. TypeScript and Python across web applications, AI agent platforms and infrastructure. Four years as Tech Lead of a computer vision product, leading a cross functional team of about 15. React Native and Expo apps shipped to iOS and Android. Part time Ph.D. research in agentic AI.</p></section>
    <section aria-labelledby="resume-experience"><h2 id="resume-experience">Experience</h2>{jobs.map(j => <section class="resume-job"><div><h3>{j.title}</h3><p>{j.period ?? `${j.from} - ${j.to}`}</p></div><p class="resume-company">{j.company} · {j.place}</p><p>{j.scope}</p>{j.proof && <p>{j.proof}</p>}{j.stack && <p class="resume-stack">{j.stack}</p>}</section>)}</section>
    <section aria-labelledby="resume-product"><h2 id="resume-product">Independent product</h2><h3>Conomi · Creator</h3><p>{portfolioProject.description} Product UX, implementation and store delivery.</p><p><a href={portfolioProject.links.website}>conomi.app</a> · <a href={portfolioProject.links.apple}>App Store</a> · <a href={portfolioProject.links.google}>Google Play</a></p></section>
    <section aria-labelledby="resume-skills"><h2 id="resume-skills">Technical skills</h2><dl class="resume-skills"><div><dt>Languages</dt><dd>TypeScript, Python, JavaScript, SQL, PHP, Go, Rust, C# / .NET</dd></div><div><dt>Web & mobile</dt><dd>React, Next.js, Node.js, FastAPI, React Native, Expo, Electron</dd></div><div><dt>Platforms</dt><dd>Claude Agent SDK, Kubernetes, GCP, Docker, GitHub Actions, NVIDIA Triton</dd></div><div><dt>Communication</dt><dd>Spanish native · English B2 · US team experience</dd></div></dl></section>
    <section aria-labelledby="resume-education"><h2 id="resume-education">Education</h2><ul>{education.map(e => <li>{e.when} · {e.what}</li>)}</ul></section>
  </article>
  <script>
    const button = document.querySelector<HTMLButtonElement>('[data-print-resume]');
    if (button) { button.hidden = false; button.addEventListener('click', () => window.print()); }
  </script>
</Base>
