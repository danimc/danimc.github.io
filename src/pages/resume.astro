---
import Base from '../layouts/Base.astro';
import { person, jobs, education, portfolioProject } from '../data/cv';
// ponytail: static PDF. After editing cv.ts, run `npm run dev` and then `npm run pdf`
---
<Base title="Résumé · Daniel Mora" description="Daniel Mora's résumé. Senior full stack engineering, AI platforms, technical leadership and mobile delivery.">
  <article class="resume-page wrap" aria-labelledby="resume-title">
    <div class="resume-actions"><a href="/">← Back to portfolio</a><a class="button" href="/Daniel_Mora_Resume.pdf" download>Download PDF</a></div>
    <header class="resume-header"><h1 id="resume-title">{person.fullName}</h1><p class="resume-role">Senior Full Stack Engineer & Tech Lead · AI Platforms, TypeScript & Python</p><p>Guadalajara, Mexico · {person.hours} · Open to remote and relocation · {person.terms}</p><p><a href={`mailto:${person.email}`}>{person.email}</a> · <a href={person.links.github}>github.com/danimc</a> · <a href={person.links.linkedin}>linkedin.com/in/dany-mc</a></p></header>
    <section aria-labelledby="resume-summary"><h2 id="resume-summary">Summary</h2><p>Full stack engineer with 11+ years in production. TypeScript and Python across web applications, AI agent platforms and infrastructure. Four years as Tech Lead of a computer vision product, leading a cross functional team of about 15. React Native and Expo apps shipped to iOS and Android. Part time Ph.D. research in agentic AI.</p></section>
    <section aria-labelledby="resume-experience"><h2 id="resume-experience">Experience</h2>{jobs.map(j => <><section class="resume-job"><div><h3>{j.title}</h3><p>{j.period ?? `${j.from} - ${j.to}`}</p></div><p class="resume-company">{j.company} · {j.place}</p>{j.highlights ? <ul>{j.highlights.map(h => <li>{h}</li>)}</ul> : <p>{j.scope}</p>}{j.stack && <p class="resume-stack">{j.stack}</p>}</section>{j.gapAfter && <p class="resume-gap">{j.gapAfter.from} - {j.gapAfter.to} · {j.gapAfter.what}</p>}</>)}</section>
    <section aria-labelledby="resume-product"><h2 id="resume-product">Independent product</h2><div class="resume-job"><div><h3>Conomi · Creator</h3><p>Aug 2024 - Present</p></div></div><p>{portfolioProject.description} Product UX, implementation and store delivery.</p><p><a href={portfolioProject.links.website}>conomi.app</a> · <a href={portfolioProject.links.apple}>App Store</a> · <a href={portfolioProject.links.google}>Google Play</a></p></section>
    <section aria-labelledby="resume-skills"><h2 id="resume-skills">Technical skills</h2><dl class="resume-skills"><div><dt>Languages</dt><dd>TypeScript, Python, JavaScript, SQL, PHP, Go, Rust, C# / .NET</dd></div><div><dt>Frontend & mobile</dt><dd>React, Next.js, React Native / Expo, Electron, Tailwind</dd></div><div><dt>Backend</dt><dd>Node.js, NestJS, FastAPI, REST APIs, gRPC</dd></div><div><dt>Data</dt><dd>PostgreSQL, Redis, Kafka, Temporal, FHIR</dd></div><div><dt>Cloud & DevOps</dt><dd>GCP, AWS, Kubernetes, Terraform, Docker, CI/CD (GitHub Actions)</dd></div><div><dt>AI</dt><dd>LLM agents (Claude Agent SDK), NVIDIA Triton, YOLO, embeddings</dd></div><div><dt>Communication</dt><dd>Spanish native · English B2 · US team experience</dd></div></dl></section>
    <section aria-labelledby="resume-education"><h2 id="resume-education">Education</h2><ul>{education.map(e => <li>{e.when} · {e.what}</li>)}</ul></section>
  </article>
</Base>
